terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }

  # Remote state is deliberately not configured: this stack is validated in CI
  # but never applied automatically. Before a real apply, add an azurerm
  # backend (Storage Account + container) so state is not kept on a laptop.
}

provider "azurerm" {
  features {
    resource_group {
      prevent_deletion_if_contains_resources = false
    }
  }
  subscription_id = var.subscription_id
}
